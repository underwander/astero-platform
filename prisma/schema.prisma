generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  balance   Float    @default(10000)
  role      String   @default("CLIENT")
  isBlocked Boolean  @default(false)
  kycStatus String   @default("PENDING")
  createdAt DateTime @default(now())

  firstName String?
  lastName  String?
  phone     String?
  country   String?
  city      String?
  address   String?

  managerId String?
  manager   User?   @relation("ManagerClients", fields: [managerId], references: [id])
  clients   User[]  @relation("ManagerClients")

  trades           Trade[]
  withdrawals      Withdrawal[]
  deposits         Deposit[]
  balanceHistory   BalanceHistory[]
  verificationDocs VerificationDocument[]
  supportMessages  SupportMessage[]
  clientNotes      ClientNote[]
  clientActions    ClientAction[]
}

model Trade {
  id         String   @id @default(cuid())
  symbol     String
  side       String
  openPrice  Float
  volume     Float    @default(1)
  closePrice Float?
  profit     Float?
  swap       Float    @default(0)
  takeProfit Float?
  stopLoss   Float?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Withdrawal {
  id          String   @id @default(cuid())
  amount      Float
  method      String
  status      String   @default("PENDING")
  destination String?
  details     String?
  createdAt   DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])
}

model Deposit {
  id        String   @id @default(cuid())
  amount    Float
  method    String?
  status    String   @default("PENDING")
  details   String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model BalanceHistory {
  id          String   @id @default(cuid())
  userId      String
  type        String
  amount      Float
  balance     Float
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model VerificationDocument {
  id            String   @id @default(cuid())
  userId        String
  type          String   @default("DOCUMENT")
  documentType  String?
  fileName      String
  fileUrl       String   @default("")
  mimeType      String?
  contentBase64 String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SupportMessage {
  id        String   @id @default(cuid())
  userId    String
  message   String
  sender    String?
  fromRole  String   @default("CLIENT")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ClientNote {
  id        String   @id @default(cuid())
  userId    String
  text      String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ClientAction {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  status      String    @default("OPEN")
  dueAt       DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}

model CompanyDocument {
  id            String   @id @default(cuid())
  title         String
  category      String   @default("General")
  fileName      String
  fileUrl       String   @default("")
  mimeType      String?
  contentBase64 String?
  isPublic      Boolean  @default(true)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
}
model ManualQuote {
  id        String   @id @default(cuid())
  symbol    String   @unique
  price     Float
  market    String   @default("Forex")
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
