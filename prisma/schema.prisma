generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  plainPassword String?
  balance   Float    @default(10000)
  role      String   @default("CLIENT")
  isBlocked Boolean  @default(false)
  tradingEnabled Boolean @default(false)
  kycStatus String   @default("PENDING")
  createdAt DateTime @default(now())
  lastLoginAt DateTime?
  lastSeenAt  DateTime?
  lastIp      String?

  firstName String?
  lastName  String?
  phone     String?
  country   String?
  city      String?
  address   String?

  managerId String?
  manager   User?   @relation("ManagerClients", fields: [managerId], references: [id])
  clients   User[]  @relation("ManagerClients")

  trades           Trade[]
  withdrawals      Withdrawal[]
  deposits         Deposit[]
  balanceHistory   BalanceHistory[]
  verificationDocs VerificationDocument[]
  supportMessages  SupportMessage[]
  clientNotes      ClientNote[]   @relation("ClientNotes")
  authoredNotes    ClientNote[]   @relation("ClientNoteManagers")
  clientActions    ClientAction[] @relation("ClientActions")
  assignedActions  ClientAction[] @relation("ClientActionManagers")
}

model Trade {
  id         String   @id @default(cuid())
  symbol     String
  side       String
  openPrice  Float
  volume     Float    @default(1)
  closePrice Float?
  profit     Float?
  swap       Float    @default(0)
  takeProfit Float?
  stopLoss   Float?
  createdAt  DateTime @default(now())
  closedAt   DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Withdrawal {
  id          String   @id @default(cuid())
  amount      Float
  method      String
  status      String   @default("PENDING")
  destination String?
  details     String?
  adminComment String?
  createdAt   DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])
}

model Deposit {
  id        String   @id @default(cuid())
  amount    Float
  method    String?
  status    String   @default("PENDING")
  details   String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model BalanceHistory {
  id          String   @id @default(cuid())
  userId      String
  type        String
  amount      Float
  balance     Float
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model VerificationDocument {
  id            String   @id @default(cuid())
  userId        String
  type          String   @default("DOCUMENT")
  documentType  String?
  fileName      String
  fileUrl       String   @default("")
  mimeType      String?
  contentBase64 String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model SupportMessage {
  id        String   @id @default(cuid())
  userId    String
  message   String
  sender    String?
  fromRole  String   @default("CLIENT")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ClientNote {
  id        String   @id @default(cuid())
  userId    String
  text      String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  managerId String?

  user    User  @relation("ClientNotes", fields: [userId], references: [id])
  manager User? @relation("ClientNoteManagers", fields: [managerId], references: [id])
}

model ClientAction {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  status      String    @default("OPEN")
  dueAt       DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  managerId   String?

  user    User  @relation("ClientActions", fields: [userId], references: [id])
  manager User? @relation("ClientActionManagers", fields: [managerId], references: [id])
}

model CompanyDocument {
  id            String   @id @default(cuid())
  title         String
  category      String   @default("General")
  fileName      String
  fileUrl       String   @default("")
  mimeType      String?
  contentBase64 String?
  isPublic      Boolean  @default(true)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
}
model ManualQuote {
  id              String   @id @default(cuid())
  symbol          String   @unique
  price           Float
  market          String   @default("Forex")
  enabled         Boolean  @default(true)
  aBookEnabled    Boolean  @default(false)
  aBookAccountIds String?
  ddeEnabled      Boolean  @default(false)
  mt4DdeServer    String?
  symbolEnabled   Boolean  @default(true)
  tradingHours    String   @default("24/5")
  quoteSource     String   @default("TwelveData")
  binanceEnabled  Boolean  @default(false)
  bitfinexEnabled Boolean  @default(false)
  hitbtcEnabled   Boolean  @default(false)
  margin          Float    @default(1)
  leverage        Int      @default(100)
  swapLong        Float    @default(0)
  swapShort       Float    @default(0)
  spread          Float    @default(14)
  commission      Float    @default(0)
  riskMode        String   @default("B-Book")
  description     String?
  calculationType String   @default("forex")
  symbolGroup     String   @default("Currencies")
  quotesFeed      String   @default("Extra quotes feed")
  spreadBid       Float    @default(0)
  spreadAsk       Float    @default(14)
  stopLevel       Float    @default(50)
  gapLevel        Float    @default(100)
  percentage      Float    @default(100)
  contractSize    Float    @default(100000)
  tickValue       Float?
  marginCurrency  String   @default("USD")
  profitCurrency  String   @default("USD")
  digits          Int      @default(5)
  delay           Int      @default(0)
  tradeForbidden  Boolean  @default(false)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}
